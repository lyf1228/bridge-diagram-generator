# 複製成 .streamlit/secrets.toml（本機用），或貼到 Streamlit Cloud → Settings → Secrets。
# 兩個值都設定後，App 匯出的 PNG 會自動存入 lyf1228@gmail.com 的雲端硬碟。
# 設定方式見 drive_collector.gs 內的安裝步驟。

drive_webhook_url = "https://script.google.com/macros/s/XXXXXXXXXXXX/exec"
drive_webhook_secret = "換成你在 drive_collector.gs 設定的 SHARED_SECRET"
